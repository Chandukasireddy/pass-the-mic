# ==============================================================================
# pass-the-mic Environment Configuration
# ==============================================================================

# Fast LLM Provider (Groq Free Tier Recommended for sub-second turn latency)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional Alternative LLM Provider
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Preferred model selection
# Groq options: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI options: gpt-4o-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Optional Host & Network Settings (for attendees connecting to host)
ROUNDTABLE_HOST=127.0.0.1
ROUNDTABLE_PORT=8000

# Standalone microphone character via Merge Gateway (separate from roundtable LLM)
# MERGE_GATEWAY_API_KEY=your_merge_gateway_api_key_here
# MERGE_LIVE_MODEL=openai/gpt-live-1
