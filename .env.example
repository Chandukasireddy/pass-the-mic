# ==============================================================================
# pass-the-mic Environment Configuration (Speaker + Microphone Edition)
# ==============================================================================

# 1. Fast Free-Tier LLM & Whisper STT Provider (Recommended)
# Get a free key at https://console.groq.com/keys
# Used for both LLM response generation (Llama-3.3) and fast Microphone STT (Whisper)
GROQ_API_KEY=your_groq_api_key_here

# 2. Optional Fallback Provider (OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Model Selection
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_MODEL=gpt-4o-mini

# 4. Microphone & Voice Activity Detection (VAD) Settings
# STT_PROVIDER options: auto (Groq Whisper -> Google Free STT), groq, google, openai
STT_PROVIDER=auto
MIC_SAMPLE_RATE=16000
MIC_SILENCE_DURATION=1.8
MIC_MAX_RECORD_SECONDS=25.0
MIC_ENERGY_THRESHOLD=0.015
